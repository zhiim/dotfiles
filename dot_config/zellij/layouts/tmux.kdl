layout {
    default_tab_template {
        children
        // Native key hints above zjstatus, using the effective Zellij keymap.
        // One-row classic UI shows mode keys in normal mode and action keys in
        // pane/search/etc. Keep it in the template for new tabs and swap layouts.
        pane size=1 borderless=true {
            plugin location="zellij:status-bar" {
                classic true
            }
        }
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left "{mode}{tabs}"
                format_center ""
                format_right "{command_cwd}"
                format_space "#[bg=black]"

                border_enabled "false"
                hide_frame_for_single_pane "false"
                pane_frame_style "titles"

                // U+E0B4 on both ends: reversed colors carve the left edge inward;
                // normal colors extend the right edge outward (not a capsule).
                mode_normal "#[fg=black,bg=blue]  #[fg=blue,bg=black] "
                mode_tmux "#[fg=black,bg=yellow]  #[fg=yellow,bg=black] "
                mode_locked "#[fg=black,bg=blue] LOCK #[fg=blue,bg=black] "
                mode_pane "#[fg=black,bg=yellow] PANE #[fg=yellow,bg=black] "
                mode_tab "#[fg=black,bg=yellow] TAB #[fg=yellow,bg=black] "
                mode_resize "#[fg=black,bg=yellow] RESIZE #[fg=yellow,bg=black] "
                mode_move "#[fg=black,bg=yellow] MOVE #[fg=yellow,bg=black] "
                mode_scroll "#[fg=black,bg=yellow] SCROLL #[fg=yellow,bg=black] "
                mode_enter_search "#[fg=black,bg=yellow] SEARCH #[fg=yellow,bg=black] "
                mode_search "#[fg=black,bg=yellow] SEARCH #[fg=yellow,bg=black] "
                mode_rename_tab "#[fg=black,bg=yellow] RENAME TAB #[fg=yellow,bg=black] "
                mode_rename_pane "#[fg=black,bg=yellow] RENAME PANE #[fg=yellow,bg=black] "
                mode_session "#[fg=black,bg=yellow] SESSION #[fg=yellow,bg=black] "
                mode_default_to_mode "tmux"

                tab_normal "#[fg=black,bg=bright_black]#[fg=blue,bg=bright_black] {index} {name} {fullscreen_indicator}{sync_indicator}#[fg=bright_black,bg=black] "
                tab_active "#[fg=black,bg=blue] 󰻿 {name} {fullscreen_indicator}{sync_indicator}#[fg=blue,bg=black] "
                tab_separator ""
                tab_sync_indicator       " "
                tab_fullscreen_indicator "󱣴 "

                // Run pwd in the focused pane's actual cwd, not the plugin's cwd.
                // Static rendering prevents path names from becoming format codes.
                command_cwd_command "/bin/pwd -P"
                command_cwd_cwd "{focused_pane_cwd}"
                command_cwd_format "#[fg=magenta,bg=black,bold] {stdout} "
                command_cwd_interval "1"
                command_cwd_rendermode "static"
            }
        }
    }
}
