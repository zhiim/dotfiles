layout {
    default_tab_template {
        children
        pane size=1 borderless=true {
            plugin location="https://github.com/dj95/zjstatus/releases/latest/download/zjstatus.wasm" {
                format_left "{mode}{tabs}"
                format_center ""
                format_right "{command_cwd}"
                format_space "#[bg=black]"

                border_enabled "false"
                hide_frame_for_single_pane "false"
                pane_frame_style "titles"

                mode_normal "#[fg=black,bg=blue]  "
                mode_tmux "#[fg=black,bg=yellow]  "
                mode_scroll "#[fg=black,bg=cyan] SCROLL "
                mode_enter_search "#[fg=black,bg=green] SEARCH INPUT "
                mode_search "#[fg=black,bg=magenta] SEARCH "
                mode_default_to_mode "tmux"

                tab_normal "#[fg=blue,bg=black] {index} {name} {fullscreen_indicator}{sync_indicator}"
                tab_active "#[fg=black,bg=blue] 󰻿 {name} {fullscreen_indicator}{sync_indicator}"
                tab_separator ""
                tab_sync_indicator       " "
                tab_fullscreen_indicator "󱣴 "

                // Run pwd in the focused pane's actual cwd, not the plugin's cwd.
                // Static rendering prevents path names from becoming format codes.
                command_cwd_command "/bin/pwd -P"
                command_cwd_cwd "{focused_pane_cwd}"
                command_cwd_format "#[fg=magenta,bg=black,bold] {stdout} "
                command_cwd_interval "1"
                command_cwd_rendermode "static"
            }
        }
    }
}
